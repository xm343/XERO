<%- include("../../views/partials/user-header") %>

<!-- Razorpay Script -->
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>

<style>
    .profile-card {
        background: #fff;
        border: 1px solid #f0f0f0;
        border-radius: 12px;
        overflow: hidden;
        margin-bottom: 30px;
        transition: all 0.3s ease;
    }
    .profile-sidebar {
        background: #f9f9f9;
        border-right: 1px solid #eee;
        height: 100%;
        padding: 40px 25px;
    }
    .nav-link-custom {
        font-weight: 700;
        color: #666;
        text-transform: uppercase;
        font-size: 13px;
        padding: 15px 20px;
        border-radius: 10px;
        margin-bottom: 8px;
        display: block;
        text-decoration: none;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        letter-spacing: 0.5px;
    }
    .nav-link-custom:hover {
        background: #f0f0f0;
        color: #000;
        transform: translateX(5px);
    }
    .nav-link-custom.active {
        background: #000;
        color: #fff;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }
    .profile-content {
        padding: 50px;
    }
    .section-header {
        font-weight: 900;
        text-transform: uppercase;
        font-size: 26px;
        margin-bottom: 35px;
        letter-spacing: 1px;
        color: #000;
        position: relative;
    }
    .section-header::after {
        content: '';
        position: absolute;
        bottom: -10px;
        left: 0;
        width: 50px;
        height: 4px;
        background: #000;
    }
    .order-card {
        border: 1.5px solid #eee;
        border-radius: 15px;
        padding: 25px;
        margin-bottom: 25px;
        transition: all 0.3s ease;
    }
    .order-card:hover {
        border-color: #000;
        box-shadow: 0 10px 25px rgba(0,0,0,0.05);
    }
    .order-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-bottom: 15px;
        border-bottom: 1px solid #f0f0f0;
        margin-bottom: 20px;
    }
    .order-id {
        font-weight: 800;
        font-size: 14px;
        color: #000;
    }
    .order-date {
        font-size: 12px;
        color: #999;
        font-weight: 600;
    }
    .order-status {
        padding: 6px 14px;
        border-radius: 8px;
        font-size: 11px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    .status-pending { background: #fff8e1; color: #ffa000; }
    .status-processing { background: #e3f2fd; color: #1976d2; }
    .status-shipped { background: #f3e5f5; color: #7b1fa2; }
    .status-delivered { background: #e8f5e9; color: #2e7d32; }
    .status-cancel { background: #ffebee; color: #d32f2f; }
    .status-payment-failed { background: #fff3e0; color: #e65100; }
    
    .item-row {
        display: flex;
        gap: 20px;
        margin-bottom: 15px;
        padding-bottom: 15px;
        border-bottom: 1px dashed #eee;
    }
    .item-row:last-child {
        border-bottom: none;
        margin-bottom: 0;
        padding-bottom: 0;
    }
    .item-image {
        width: 70px;
        height: 70px;
        object-fit: cover;
        border-radius: 10px;
        background: #f9f9f9;
    }
    .item-info h6 {
        font-weight: 700;
        margin-bottom: 5px;
        font-size: 15px;
    }
    .item-info p {
        font-size: 13px;
        color: #777;
        margin-bottom: 0;
    }
    .order-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 20px;
        padding-top: 15px;
        border-top: 1px solid #f0f0f0;
    }
    .order-total {
        font-weight: 900;
        font-size: 18px;
    }
    .btn-view-details {
        background: #000;
        color: #fff;
        padding: 10px 25px;
        border-radius: 8px;
        font-weight: 700;
        text-transform: uppercase;
        font-size: 11px;
        text-decoration: none;
        transition: all 0.3s ease;
    }
    .btn-view-details:hover {
        background: #333;
        color: #fff;
    }
    .btn-retry-payment {
        background: #e65100;
        color: #fff;
        padding: 10px 25px;
        border-radius: 8px;
        font-weight: 700;
        text-transform: uppercase;
        font-size: 11px;
        text-decoration: none;
        border: none;
        transition: all 0.3s ease;
    }
    .btn-retry-payment:hover {
        background: #ef6c00;
        color: #fff;
    }
    .avatar-placeholder {
        width: 100px;
        height: 100px;
        background: #000;
        color: #fff;
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 40px;
        font-weight: 900;
        margin: 0 auto 20px;
        box-shadow: 0 10px 20px rgba(0,0,0,0.1);
    }
</style>

<div class="container my-5 pt-4">
    <div class="profile-card shadow-sm">
        <div class="row g-0">
            <!-- Sidebar -->
            <div class="col-lg-3">
                <div class="profile-sidebar text-center">
                    <div class="avatar-placeholder">
                        <%= user.name.charAt(0).toUpperCase() %>
                    </div>
                    <h5 class="fw-bold mb-1"><%= user.name %></h5>
                    <p class="text-muted small mb-4"><%= user.email %></p>
                    
                    <nav class="text-start mt-4">
                        <a href="/user-profile" class="nav-link-custom">
                            <i class="fa-solid fa-user me-2"></i> Profile Overview
                        </a>
                        <a href="/my-orders" class="nav-link-custom active">
                            <i class="fa-solid fa-box me-2"></i> My Orders
                        </a>
                        <a href="/manage-address" class="nav-link-custom">
                            <i class="fa-solid fa-location-dot me-2"></i> My Addresses
                        </a>
                        <a href="/logout" class="nav-link-custom text-danger">
                            <i class="fa-solid fa-right-from-bracket me-2"></i> Logout
                        </a>
                    </nav>
                </div>
            </div>
            
            <!-- Content -->
            <div class="col-lg-9">
                <div class="profile-content">
                    <h2 class="section-header">My Orders</h2>
                    
                    <% if (orders && orders.length > 0) { %>
                        <% orders.forEach(order => { %>
                            <div class="order-card">
                                <div class="order-header">
                                    <div>
                                        <span class="order-id">ID: #<%= order.orderId.substring(0,8).toUpperCase() %></span>
                                        <div class="order-date"><%= new Date(order.createdOn).toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' }) %></div>
                                    </div>
                                    <span class="order-status status-<%= order.status.replace(/\s+/g, '-').toLowerCase() %>">
                                        <%= order.status %>
                                    </span>
                                </div>
                                
                                <div class="order-items">
                                    <% order.orderedItems.forEach(item => { %>
                                        <div class="item-row">
                                            <% if (item.product && item.product.productImage && item.product.productImage.length > 0) { %>
                                                <img src="/uploads/re-image/<%= item.product.productImage[0] %>" alt="<%= item.product.productName %>" class="item-image">
                                            <% } else { %>
                                                <div class="item-image d-flex align-items-center justify-content-center bg-light">
                                                    <i class="fa-solid fa-image text-muted"></i>
                                                </div>
                                            <% } %>
                                            <div class="item-info">
                                                <h6><%= item.product ? item.product.productName : 'Product Removed' %></h6>
                                                <p>Quantity: <%= item.quantity %> • Price: ₹<%= item.price.toLocaleString() %></p>
                                            </div>
                                        </div>
                                    <% }) %>
                                </div>
                                
                                <div class="order-footer">
                                    <div class="order-total">
                                        Total: ₹<%= order.finalAmount.toLocaleString() %>
                                    </div>
                                    <div class="d-flex gap-2">
                                        <% if (order.status === 'Payment Failed') { %>
                                            <button class="btn-retry-payment" onclick="retryPayment('<%= order.orderId %>')">
                                                Retry Payment
                                            </button>
                                        <% } %>
                                        <a href="/order-success?id=<%= order.orderId %>" class="btn-view-details">View Details</a>
                                        <% if (['Pending', 'Processing', 'Payment Failed'].includes(order.status)) { %>
                                            <button class="btn btn-outline-danger" 
                                                    style="padding: 10px 25px; border-radius: 8px; font-weight: 700; text-transform: uppercase; font-size: 11px; transition: all 0.3s ease;" 
                                                    onclick="confirmCancelOrder('<%= order.orderId %>')">
                                                Cancel Order
                                            </button>
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <div class="text-center py-5">
                            <i class="fa-solid fa-bag-shopping fa-3x text-light mb-3"></i>
                            <p class="text-muted">You haven't placed any orders yet.</p>
                            <a href="/shop" class="btn btn-dark mt-3 px-4">Start Shopping</a>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    async function retryPayment(orderId) {
        try {
            Swal.fire({
                title: 'Initiating Payment...',
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            const response = await fetch('/retry-payment', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ orderId })
            });

            const data = await response.json();

            if (data.success) {
                payWithRazorpay(data);
            } else {
                Swal.fire('Error', data.message || 'Failed to initiate payment', 'error');
            }
        } catch (error) {
            console.error('Error in retryPayment:', error);
            Swal.fire('Error', 'An unexpected error occurred', 'error');
        }
    }

    function payWithRazorpay(orderData) {
        const options = {
            "key": "<%= locals.razorpayKey || '' %>",
            "amount": orderData.razorpayOrder.amount,
            "currency": "INR",
            "name": "XERO Apparel",
            "description": "Purchase Order",
            "order_id": orderData.razorpayOrder.id,
            "handler": function (response) {
                verifyPayment(response, orderData.orderId);
            },
            "prefill": {
                "name": "<%= user.name %>",
                "email": "<%= user.email %>",
                "contact": "<%= user.phone || '' %>"
            },
            "theme": {
                "color": "#000000"
            }
        };
        const rzp1 = new Razorpay(options);
        rzp1.open();
        Swal.close();
    }

    async function verifyPayment(razorpayResponse, orderId) {
        try {
            const response = await fetch('/verify-payment', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    ...razorpayResponse,
                    orderId,
                    isBuyNow: true // To avoid stock deduction if already deducted (though here we only deduct on success)
                })
            });

            const data = await response.json();

            if (data.success) {
                Swal.fire({
                    title: 'Payment Successful!',
                    text: 'Your order has been updated successfully.',
                    icon: 'success',
                    confirmButtonColor: '#000'
                }).then(() => {
                    window.location.reload();
                });
            } else {
                Swal.fire('Error', 'Payment verification failed.', 'error');
            }
        } catch (error) {
            console.error('Error verifying payment:', error);
            Swal.fire('Error', 'Something went wrong during payment verification.', 'error');
        }
    }

    async function confirmCancelOrder(orderId) {
        const { value: isConfirmed } = await Swal.fire({
            title: 'Cancel Order?',
            text: "Are you sure you want to cancel this order?",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#000',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, Cancel it!',
            cancelButtonText: 'No, Keep it'
        });

        if (isConfirmed) {
            try {
                const response = await fetch('/cancel-order', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ orderId })
                });

                const data = await response.json();

                if (data.success) {
                    Swal.fire({
                        title: 'Cancelled!',
                        text: 'Your order has been cancelled.',
                        icon: 'success',
                        showConfirmButton: false,
                        timer: 1500
                    }).then(() => {
                        window.location.reload();
                    });
                } else {
                    Swal.fire({
                        title: 'Error!',
                        text: data.message || 'Failed to cancel the order.',
                        icon: 'error'
                    });
                }
            } catch (error) {
                console.error('Error:', error);
                Swal.fire({
                    title: 'Error!',
                    text: 'An error occurred while cancelling the order.',
                    icon: 'error'
                });
            }
        }
    }
</script>

<%- include("../../views/partials/user-footer") %>